# PMHNP Billing AI Agent — production environment example
# Copy to a secure env file outside the repo or to /etc/pmhnp/pmhnp.env and replace every placeholder.

PORT=18087

# Runtime paths
PMHNP_STATE_DIR=/var/lib/pmhnp/state
PMHNP_BACKUPS_DIR=/var/lib/pmhnp/backups
PMHNP_PUBLIC_DIR=/opt/pmhnp-denial-copilot/public
PMHNP_SNAPSHOT_PATH=/opt/pmhnp-denial-copilot/public/app/data/dashboard-snapshot.json

# Production security
PMHNP_REQUIRE_FORWARDED_TLS=true
PMHNP_ENFORCE_OPERATIONAL_AUTH=true
PMHNP_REQUIRE_ACTOR_HEADERS=true
PMHNP_MINIMAL_HEALTH_RESPONSE=true
PMHNP_ALLOW_LEGACY_STATIC_TOKENS=false

# Signed token auth
PMHNP_TOKEN_SIGNING_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
PMHNP_CLIENT_LOGIN_KEY=REPLACE_WITH_LONG_RANDOM_CLIENT_KEY
PMHNP_REVIEWER_LOGIN_KEY=REPLACE_WITH_LONG_RANDOM_REVIEWER_KEY
PMHNP_ADMIN_LOGIN_KEY=REPLACE_WITH_LONG_RANDOM_ADMIN_KEY
PMHNP_TOKEN_TTL_SECONDS=3600

# Optional legacy break-glass tokens (only if you intentionally re-enable legacy mode)
PMHNP_CLIENT_PORTAL_TOKEN=
PMHNP_OPERATIONAL_API_TOKEN=
