{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cortex.learning_os.transfer_profile.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "profileId", "version", "mathConceptIds", "semanticMatcherId",
    "activationConditions", "requiredAssumptions", "contraindications",
    "computationalFormulation", "implementationPatterns", "verification",
    "risks", "qualificationPolicy", "source", "truthBoundary"
  ],
  "properties": {
    "schemaVersion": { "const": "cortex.learning_os.transfer_profile.v1" },
    "profileId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "mathConceptIds": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "semanticMatcherId": {
      "enum": ["code-exact-integer-multiplication-v1", "code-polynomial-factoring-v1"]
    },
    "activationConditions": { "$ref": "#/$defs/codeList" },
    "requiredAssumptions": { "$ref": "#/$defs/assumptionList" },
    "contraindications": { "$ref": "#/$defs/gateList" },
    "computationalFormulation": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "implementationPatterns": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["oracleId", "strategy", "deterministic"],
      "properties": {
        "oracleId": { "enum": ["exact-integer-product-v1", "integer-polynomial-identity-v1"] },
        "strategy": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "deterministic": { "const": true }
      }
    },
    "risks": {
      "type": "object", "additionalProperties": false,
      "required": ["complexity", "numerical"],
      "properties": {
        "complexity": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "numerical": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "qualificationPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["policyId", "requiredFamilies", "candidateArm", "noTransferArm"],
      "properties": {
        "policyId": { "const": "coding-transfer-v0.9" },
        "requiredFamilies": {
          "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true,
          "items": { "enum": ["acquisition", "held-out", "negative-semantic", "assumption-violation", "regression"] }
        },
        "candidateArm": { "const": "candidate" },
        "noTransferArm": { "const": "no-transfer" }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["baseCommit", "sourceDigest", "profileDigest"],
      "properties": {
        "baseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "sourceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "profileDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "truthBoundary": { "type": "string", "minLength": 1, "maxLength": 2000 }
  },
  "$defs": {
    "codeList": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]*$" }
    },
    "assumptionList": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["code", "description", "observable"],
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "observable": { "const": true }
        }
      }
    },
    "gateList": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["code", "description"],
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "description": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    }
  }
}
