{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cortex.learning_os.research_review_output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "adversarial", "findings"],
  "properties": {
    "status": { "enum": ["passed", "failed"] },
    "adversarial": { "const": true },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 4000 }
    }
  }
}
