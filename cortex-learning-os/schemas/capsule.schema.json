{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cortex.learning_os.capsule.v0",
  "type": "object",
  "required": [
    "schemaVersion",
    "capsuleId",
    "domain",
    "version",
    "trustState",
    "activeCurriculumId",
    "activeExamIds",
    "promotionThresholds",
    "truthBoundary"
  ],
  "properties": {
    "schemaVersion": {
      "const": "cortex.learning_os.capsule.v0"
    },
    "trustState": {
      "enum": [
        "untrained",
        "candidate",
        "trusted",
        "quarantined"
      ]
    },
    "activeExamIds": {
      "type": "array",
      "minItems": 1
    }
  },
  "additionalProperties": true
}
