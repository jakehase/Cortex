{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule",
    "scope",
    "contraindications",
    "likelyRootCause"
  ],
  "properties": {
    "rule": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "contraindications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "likelyRootCause": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    }
  }
}
