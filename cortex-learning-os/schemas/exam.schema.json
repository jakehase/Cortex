{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cortex.learning_os.exam.v0",
  "type": "object",
  "required": [
    "schemaVersion",
    "examId",
    "capsuleId",
    "version",
    "title",
    "passThreshold",
    "allowedTools",
    "items",
    "truthBoundary"
  ],
  "properties": {
    "schemaVersion": {
