{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cortex.learning_os.model_answer_output.v0",
  "type": "object",
  "required": ["answers"],
  "properties": {
    "answers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["itemId", "answer"],
        "properties": {
          "itemId": { "type": "string", "minLength": 1 },
          "answer": {}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
