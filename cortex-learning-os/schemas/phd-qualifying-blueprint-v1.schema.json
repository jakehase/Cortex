{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cortex.learning_os.phd_qualifying_blueprint.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "blueprintId",
    "version",
    "curriculum",
    "rubric",
    "unseenExamProtocol",
    "coreExams",
    "specializationExam",
    "formalProofGate",
    "researchGate",
    "truthBoundary"
  ],
  "properties": {
    "schemaVersion": {
      "const": "cortex.learning_os.phd_qualifying_blueprint.v1"
    },
    "blueprintId": {
      "const": "math-phd-qualifying-v1"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\."
    },
    "curriculum": {
      "$ref": "#/$defs/curriculumRef"
    },
    "rubric": {
      "$ref": "#/$defs/rubricRef"
    },
    "unseenExamProtocol": {
      "$ref": "#/$defs/unseenExamProtocol"
    },
    "coreExams": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/exam"
      }
    },
    "specializationExam": {
      "$ref": "#/$defs/specialization"
    },
    "formalProofGate": {
      "$ref": "#/$defs/formalProofGate"
    },
    "researchGate": {
      "$ref": "#/$defs/researchGate"
    },
    "truthBoundary": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "curriculumRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "curriculumId",
        "version"
      ],
      "properties": {
        "curriculumId": {
          "const": "math-phd-trajectory-v1"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rubricRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rubricId",
        "version"
      ],
      "properties": {
        "rubricId": {
          "const": "math-phd-competency-v1"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unseenExamProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemBankSealedBeforeAttempt",
        "candidateNoPriorAccessAttested",
        "promptCommitmentRequired",
        "independentProctorRequired",
        "uniqueAttemptRequired",
        "qualificationNotReview"
      ],
      "properties": {
        "itemBankSealedBeforeAttempt": {
          "const": true
        },
        "candidateNoPriorAccessAttested": {
          "const": true
        },
        "promptCommitmentRequired": {
          "const": true
        },
        "independentProctorRequired": {
          "const": true
        },
        "uniqueAttemptRequired": {
          "const": true
        },
        "qualificationNotReview": {
          "const": true
        }
      }
    },
    "formalProofGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredObligationPolicy",
        "acceptedKernels",
        "kernelOutputDigestRequired",
        "proofArtifactDigestRequired",
        "researchMainResultMustBindArtifactDigest"
      ],
      "properties": {
        "requiredObligationPolicy": {
          "const": "all_rubric_required_obligations"
        },
        "acceptedKernels": {
          "const": [
            "lean4",
            "coq",
            "isabelle"
          ]
        },
        "kernelOutputDigestRequired": {
          "const": true
        },
        "proofArtifactDigestRequired": {
          "const": true
        },
        "researchMainResultMustBindArtifactDigest": {
          "const": true
        }
      }
    },
    "researchGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateId",
        "boundedArtifactRequired",
        "independentReproductionRequired",
        "independentReviewRequired",
        "frozenEnvironmentDigestRequired",
        "frozenCorpusDigestRequired",
        "researchMainResultFormalProofRequired",
        "acceptedNoveltyStatuses",
        "globalNoveltyInferenceForbidden"
      ],
      "properties": {
        "gateId": {
          "const": "phd-bounded-research-gate-v1"
        },
        "boundedArtifactRequired": {
          "const": true
        },
        "independentReproductionRequired": {
          "const": true
        },
        "independentReviewRequired": {
          "const": true
        },
        "frozenEnvironmentDigestRequired": {
          "const": true
        },
        "frozenCorpusDigestRequired": {
          "const": true
        },
        "researchMainResultFormalProofRequired": {
          "const": true
        },
        "acceptedNoveltyStatuses": {
          "const": [
            "unestablished",
            "bounded_corpus_only",
            "externally_established"
          ]
        },
        "globalNoveltyInferenceForbidden": {
          "const": true
        }
      }
    },
    "exam": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "examId",
        "version",
        "title",
        "required",
        "tracks",
        "durationMinutes",
        "minimumProblemCount",
        "passThreshold",
        "evidenceRequirements"
      ],
      "properties": {
        "examId": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "required": {
          "const": true
        },
        "tracks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "durationMinutes": {
          "type": "integer",
          "minimum": 60
        },
        "minimumProblemCount": {
          "type": "integer",
          "minimum": 1
        },
        "passThreshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "evidenceRequirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "specialization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "examId",
        "version",
        "title",
        "eligibleTracks",
        "minimumDeclaredTracks",
        "durationMinutes",
        "minimumProblemCount",
        "passThreshold",
        "evidenceRequirements"
      ],
      "properties": {
        "examId": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "eligibleTracks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "minimumDeclaredTracks": {
          "type": "integer",
          "minimum": 1
        },
        "durationMinutes": {
          "type": "integer",
          "minimum": 60
        },
        "minimumProblemCount": {
          "type": "integer",
          "minimum": 1
        },
        "passThreshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "evidenceRequirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
