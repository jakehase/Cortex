{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cortex.learning_os.acquisition_assessment_registry.v2",
  "type": "array",
  "minItems": 264,
  "maxItems": 264,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schemaVersion",
      "assessmentId",
      "bankId",
      "bankDigest",
      "itemContentDigest",
      "checkerSpecificationSha256",
      "conceptId",
      "theoremFamilyId",
      "assessmentClass",
      "assessmentRole",
      "productionEligible",
      "outcomeIds",
      "stage",
      "trackIds",
      "trustPolicyDigest",
      "deploymentDigest",
      "campaign",
      "authorAuthorityId",
      "reviewerAuthorityId"
    ],
    "properties": {
      "schemaVersion": {
        "const": "cortex.learning_os.acquisition_assessment_registry_entry.v2"
      },
      "assessmentId": { "$ref": "#/$defs/identifier" },
      "bankId": { "$ref": "#/$defs/identifier" },
      "bankDigest": { "$ref": "#/$defs/digest" },
      "itemContentDigest": { "$ref": "#/$defs/digest" },
      "checkerSpecificationSha256": { "$ref": "#/$defs/digest" },
      "conceptId": { "$ref": "#/$defs/identifier" },
      "theoremFamilyId": { "$ref": "#/$defs/identifier" },
      "assessmentClass": {
        "const": "independently_authored_concept_specific"
      },
      "assessmentRole": { "const": "acquisition" },
      "productionEligible": { "const": true },
      "outcomeIds": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^outcome:[0-9a-f]{64}$"
        }
      },
      "stage": { "$ref": "#/$defs/identifier" },
      "trackIds": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/identifier" }
      },
      "trustPolicyDigest": { "$ref": "#/$defs/digest" },
      "deploymentDigest": { "$ref": "#/$defs/digest" },
      "campaign": { "$ref": "#/$defs/campaign" },
      "authorAuthorityId": { "$ref": "#/$defs/identifier" },
      "reviewerAuthorityId": { "$ref": "#/$defs/identifier" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaignId", "campaignDigest"],
      "properties": {
        "campaignId": { "$ref": "#/$defs/identifier" },
        "campaignDigest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
