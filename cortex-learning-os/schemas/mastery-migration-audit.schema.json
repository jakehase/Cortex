{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cortex.learning_os.mastery_migration_audit.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "migrationId",
    "sourceCommit",
    "migratedAt",
    "source",
    "target",
    "preservation",
    "convertedAcquiredConceptCount",
    "clearedActiveReviewScheduleCount",
    "addedConceptIds",
    "truthBoundary",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": "cortex.learning_os.mastery_migration_audit.v1" },
    "migrationId": { "type": "string" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "migratedAt": { "type": "string", "format": "date-time" },
    "source": { "type": "object" },
    "target": { "type": "object" },
    "preservation": { "type": "object" },
    "convertedAcquiredConceptCount": { "type": "integer", "minimum": 0 },
    "clearedActiveReviewScheduleCount": { "type": "integer", "minimum": 0 },
    "addedConceptIds": { "type": "array", "minItems": 48, "uniqueItems": true, "items": { "type": "string" } },
    "truthBoundary": { "type": "string" },
    "signature": { "type": "object", "required": ["algorithm", "keyId", "digest"] }
  }
}
