{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cortex.learning_os.mastery_delta.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "baseRevision",
    "curriculumId",
    "capsuleId",
    "policyDigest",
    "completedAt",
    "events",
    "authority",
    "truthBoundary"
  ],
  "properties": {
    "schemaVersion": { "const": "cortex.learning_os.mastery_delta.v2" },
    "runId": { "type": "string" },
    "baseRevision": { "type": "integer", "minimum": 0 },
    "curriculumId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "capsuleId": { "type": "string" },
    "policyDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "completedAt": { "type": "string", "format": "date-time" },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["conceptId", "role", "passed", "completedAt", "evidenceDigest"],
        "properties": {
          "conceptId": { "type": "string" },
          "role": { "enum": ["acquisition", "correction"] },
          "passed": { "type": "boolean" },
          "completedAt": { "type": "string", "format": "date-time" },
          "evidenceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "authority": { "const": "worker_proposal_only" },
    "truthBoundary": { "type": "string" }
  }
}
