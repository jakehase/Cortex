{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cortex.learning_os.execution_closure.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceCommit",
    "sourceTree",
    "productTree",
    "checkoutSha256",
    "runtimeSha256",
    "closureSha256",
    "immutable",
    "fileCount",
    "runtimeFileCount",
    "entryCount",
    "entries",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": "cortex.learning_os.execution_closure.v2" },
    "sourceCommit": { "$ref": "#/$defs/commit" },
    "sourceTree": { "$ref": "#/$defs/commit" },
    "productTree": { "$ref": "#/$defs/commit" },
    "checkoutSha256": { "$ref": "#/$defs/digest" },
    "runtimeSha256": { "$ref": "#/$defs/digest" },
    "closureSha256": { "$ref": "#/$defs/digest" },
    "immutable": { "type": "boolean" },
    "fileCount": { "type": "integer", "minimum": 1, "maximum": 4096 },
    "runtimeFileCount": { "type": "integer", "minimum": 1, "maximum": 4096 },
    "entryCount": { "type": "integer", "minimum": 1, "maximum": 8192 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8192,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "type", "uid", "gid", "mode"],
        "properties": {
          "path": { "$ref": "#/$defs/entryPath" },
          "type": { "enum": ["directory", "file"] },
          "uid": { "const": 0 },
          "gid": { "const": 0 },
          "mode": { "enum": ["0444", "0555"] }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mode", "bytes", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/filePath" },
          "mode": { "enum": ["100644", "100755"] },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 67108864 },
          "sha256": { "$ref": "#/$defs/digest" }
        }
      }
    }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "entryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(cortex-learning-os|plugins)(/[A-Za-z0-9._-]+)*$"
    },
    "filePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(cortex-learning-os|plugins)(/[A-Za-z0-9._-]+)+$"
    }
  }
}
