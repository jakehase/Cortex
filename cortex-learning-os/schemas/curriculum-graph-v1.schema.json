{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cortex.learning_os.curriculum_graph.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "curriculumId", "capsuleId", "domain", "version", "concepts", "truthBoundary"],
  "properties": {
    "schemaVersion": { "const": "cortex.learning_os.curriculum_graph.v1" },
    "curriculumId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "capsuleId": { "type": "string" },
    "domain": { "type": "string" },
    "version": { "type": "string" },
    "concepts": {
      "type": "array",
      "minItems": 84,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conceptId", "title", "category", "prerequisites", "outcomes"],
        "properties": {
          "conceptId": { "type": "string" },
          "title": { "type": "string" },
          "category": { "type": "string" },
          "prerequisites": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "outcomes": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "truthBoundary": { "type": "string", "minLength": 1 }
  }
}
