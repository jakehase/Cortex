{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cortex.learning_os.research_source_bundle.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "files"],
  "properties": {
    "schemaVersion": { "const": "cortex.learning_os.research_source_bundle.v1" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytesBase64", "sha256", "executable"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*//)(?!.*\\./)(?!.*\\.$)(?!.*\\/$)[A-Za-z0-9._/-]+$"
          },
          "bytesBase64": {
            "type": "string",
            "minLength": 4,
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "executable": { "type": "boolean" }
        }
      }
    }
  }
}
