{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cortex.learning_os.independent_assessment_bank.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bankId",
    "fixtureOnly",
    "assessmentClass",
    "purpose",
    "bindings",
    "items",
    "bankDigest",
    "authorAttestation",
    "reviewerAttestation",
    "truthBoundary"
  ],
  "properties": {
    "schemaVersion": {
      "const": "cortex.learning_os.independent_assessment_bank.v1"
    },
    "bankId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "fixtureOnly": { "const": false },
    "assessmentClass": {
      "const": "independently_authored_concept_specific"
    },
    "purpose": { "enum": ["acquisition", "validity", "retention"] },
    "bindings": {
      "$ref": "independent-assessment-item-v1.schema.json#/$defs/bindings"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$ref": "independent-assessment-item-v1.schema.json"
      }
    },
    "bankDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorAttestation": { "$ref": "authority-attestation.schema.json" },
    "reviewerAttestation": { "$ref": "authority-attestation.schema.json" },
    "truthBoundary": { "type": "string", "minLength": 1 }
  }
}
