{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cortex.learning_os.mastery_state.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "curriculumId",
    "capsuleId",
    "policyDigest",
    "updatedAt",
    "concepts",
    "pendingRepairs",
    "appliedRunIds",
    "appliedRunReceipts",
    "migration",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": "cortex.learning_os.mastery_state.v2" },
    "revision": { "type": "integer", "minimum": 0 },
    "curriculumId": { "const": "math-continuous-acquisition-v1" },
    "capsuleId": { "type": "string" },
    "policyDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "concepts": {
      "type": "object",
      "minProperties": 84,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "attempts",
          "passes",
          "failures",
          "consecutivePasses",
          "consecutiveFailures",
          "historicalReviewStage",
          "lastAttemptedAt",
          "lastReviewedAt",
          "historicalNextReviewAt",
          "nextReviewAt",
          "acquiredAt",
          "lastEvidenceDigest",
          "lastRunId"
        ],
        "properties": {
          "state": { "enum": ["unassessed", "learning", "acquired", "blocked_prerequisite"] },
          "attempts": { "type": "integer", "minimum": 0 },
          "passes": { "type": "integer", "minimum": 0 },
          "failures": { "type": "integer", "minimum": 0 },
          "consecutivePasses": { "type": "integer", "minimum": 0 },
          "consecutiveFailures": { "type": "integer", "minimum": 0 },
          "historicalReviewStage": { "type": "integer", "minimum": 0 },
          "lastAttemptedAt": { "type": ["string", "null"], "format": "date-time" },
          "lastReviewedAt": { "type": ["string", "null"], "format": "date-time" },
          "historicalNextReviewAt": { "type": ["string", "null"], "format": "date-time" },
          "nextReviewAt": { "const": null },
          "acquiredAt": { "type": ["string", "null"], "format": "date-time" },
          "lastEvidenceDigest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "lastRunId": { "type": ["string", "null"] }
        }
      }
    },
    "pendingRepairs": { "type": "array" },
    "appliedRunIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "appliedRunReceipts": { "type": "array" },
    "migration": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": [
            "schemaVersion",
            "migrationId",
            "sourceRevision",
            "targetRevision",
            "sourceStateDigest",
            "sourcePolicyDigest",
            "sourceCurriculumDigest",
            "targetPolicyDigest",
            "targetCurriculumDigest",
            "migratedAt"
          ]
        }
      ]
    },
    "signature": { "type": "object", "required": ["algorithm", "keyId", "digest"] }
  }
}
