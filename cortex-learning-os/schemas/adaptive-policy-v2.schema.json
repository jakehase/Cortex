{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cortex.learning_os.adaptive_policy.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyId",
    "curriculumId",
    "capsuleId",
    "mode",
    "reviewSelection",
    "prerequisiteGate",
    "budgets",
    "modelRuntime",
    "candidate",
    "pairedEvaluation",
    "liveActivationProfileByConcept",
    "lessonExpiryDays",
    "truthBoundary"
  ],
  "properties": {
    "schemaVersion": { "const": "cortex.learning_os.adaptive_policy.v2" },
    "policyId": { "const": "adaptive-math-continuous-v1" },
    "curriculumId": { "const": "math-continuous-acquisition-v1" },
    "capsuleId": { "type": "string" },
    "mode": { "const": "continuous_acquisition" },
    "reviewSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "scheduleNewReviews", "rejectEarlyReview"],
      "properties": {
        "enabled": { "const": false },
        "scheduleNewReviews": { "const": false },
        "rejectEarlyReview": { "const": true }
      }
    },
    "prerequisiteGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedStates", "minimumConsecutivePasses", "ignoreHistoricalReviewSchedule"],
      "properties": {
        "allowedStates": { "const": ["acquired"] },
        "minimumConsecutivePasses": { "type": "integer", "minimum": 1 },
        "ignoreHistoricalReviewSchedule": { "const": true }
      }
    },
    "budgets": { "type": "object" },
    "modelRuntime": { "type": "object" },
    "candidate": { "type": "object" },
    "pairedEvaluation": { "type": "object" },
    "liveActivationProfileByConcept": { "type": "object" },
    "lessonExpiryDays": { "type": "integer", "minimum": 1, "maximum": 365 },
    "truthBoundary": { "type": "string", "minLength": 1 }
  }
}
