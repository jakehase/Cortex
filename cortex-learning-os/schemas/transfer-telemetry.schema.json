{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cortex.learning_os.transfer_telemetry.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "updatedAt", "counters", "reasonCounts", "records"],
  "properties": {
    "schemaVersion": { "const": "cortex.learning_os.transfer_telemetry.v1" },
    "mode": { "const": "content_free" },
    "updatedAt": { "type": ["string", "null"], "format": "date-time" },
    "counters": {
      "type": "object", "additionalProperties": false,
      "required": ["observed", "applicable", "shadowSelected", "applied", "noMatch", "bypassed", "registryInvalid", "contextRejected"],
      "properties": {
        "observed": { "$ref": "#/$defs/count" },
        "applicable": { "$ref": "#/$defs/count" },
        "shadowSelected": { "$ref": "#/$defs/count" },
        "applied": { "$ref": "#/$defs/count" },
        "noMatch": { "$ref": "#/$defs/count" },
        "bypassed": { "$ref": "#/$defs/count" },
        "registryInvalid": { "$ref": "#/$defs/count" },
        "contextRejected": { "$ref": "#/$defs/count" }
      }
    },
    "reasonCounts": {
      "type": "object", "maxProperties": 64, "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9][a-z0-9._-]{0,127}$": { "$ref": "#/$defs/count" }
      }
    },
    "records": {
      "type": "array", "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "recordedAt", "transferMode", "outcome", "answerInfluence", "applicable",
          "reasonCodes", "profileIds", "matcherIds", "observedAssumptionCodes",
          "negativeGateCodes", "evidenceDigests"
        ],
        "properties": {
          "recordedAt": { "type": "string", "format": "date-time" },
          "transferMode": { "enum": ["shadow", "active"] },
          "outcome": { "enum": ["applied", "shadow_selected", "registry_invalid", "bypassed", "context_rejected", "no_match"] },
          "answerInfluence": { "type": "boolean" },
          "applicable": { "type": "boolean" },
          "reasonCodes": { "$ref": "#/$defs/codes" },
          "profileIds": { "$ref": "#/$defs/codes" },
          "matcherIds": { "$ref": "#/$defs/codes" },
          "observedAssumptionCodes": { "$ref": "#/$defs/codes" },
          "negativeGateCodes": { "$ref": "#/$defs/codes" },
          "evidenceDigests": {
            "type": "array", "maxItems": 8, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          },
          "transferRegistryRevision": { "type": "integer", "minimum": 0 },
          "transferRegistryKeyId": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
        }
      }
    }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0 },
    "codes": {
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]*$" }
    }
  }
}
