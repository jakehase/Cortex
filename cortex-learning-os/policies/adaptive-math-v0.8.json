    "prohibitedPhrases": [
      "ignore previous",
      "system prompt",
      "expected answer",
      "checker.expected"
    ]
  },
  "pairedEvaluation": {
    "pairCount": 6,
    "minimumValidPairs": 6,
    "minimumCandidateAccuracy": 0.83,
    "minimumAbsoluteLift": 0.5,
    "maximumNoCandidateOnlyRegressions": 0,
    "maximumExactMcNemarP": 0.05
  },
  "liveActivationProfileByConcept": {
    "algebra-linear-equations": "linear_equation",
    "algebra-quadratics": "quadratic_roots",
    "functions-evaluation": "function_evaluation",
    "functions-inverse": "inverse_function",
    "series-geometric": "geometric_series",
    "algebra-absolute-value": "absolute_value_equation",
    "probability-binomial": "binomial_probability",
    "probability-complements": "complement_probability",
    "probability-combinatorics": "combinations_permutations"
  },
  "lessonExpiryDays": 90,
  "truthBoundary": "This policy gates verifier-backed adaptive evidence and narrow lesson retrieval only. It does not define model-weight learning or general mastery."
}
