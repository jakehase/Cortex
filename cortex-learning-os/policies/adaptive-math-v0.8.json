{
  "schemaVersion": "cortex.learning_os.adaptive_policy.v1",
  "policyId": "adaptive-math-v0.8",
  "curriculumId": "math-foundations-curriculum-v0",
  "capsuleId": "math-foundations-v0",
  "prerequisiteGate": {
    "allowedStates": [
      "review",
      "mastered"
    ],
    "minimumConsecutivePasses": 1,
    "overduePassesGate": false
  },
  "spacingDays": [
    0,
    1,
    7,
    30,
    90
  ],
  "lapse": {
    "resetReviewStage": 0,
    "scheduleImmediateRepair": true
  },
  "budgets": {
    "maxSteps": 12,
    "maxModelCalls": 18,
    "maxAttemptsPerConcept": 3,
    "maxArtifactFiles": 2000,
    "maxArtifactBytes": 67108864
  },
  "modelRuntime": {
    "provider": "openai-codex",
    "model": "gpt-5.6-sol",
    "thinking": "xhigh",
    "sandbox": "read-only",
    "toolsAllowed": false
  },
  "candidate": {
    "maximumRuleChars": 1200,
    "maximumScopeChars": 800,
    "maximumRootCauseChars": 800,
    "maximumContraindications": 8,
