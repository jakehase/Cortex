{
  "schemaVersion": "cortex.learning_os.adaptive_policy.v2",
  "policyId": "adaptive-math-continuous-v1",
  "curriculumId": "math-continuous-acquisition-v1",
  "capsuleId": "math-foundations-v0",
  "mode": "continuous_acquisition",
  "reviewSelection": {
    "enabled": false,
    "scheduleNewReviews": false,
    "rejectEarlyReview": true
  },
  "prerequisiteGate": {
    "allowedStates": [
      "acquired"
    ],
    "minimumConsecutivePasses": 1,
    "ignoreHistoricalReviewSchedule": true
  },
  "budgets": {
    "maxSteps": 12,
    "maxModelCalls": 18,
    "maxAttemptsPerConcept": 3,
    "maxArtifactFiles": 2000,
    "maxArtifactBytes": 67108864
  },
  "modelRuntime": {
    "provider": "openai-codex",
    "model": "gpt-5.6-sol",
    "thinking": "xhigh",
    "sandbox": "read-only",
    "toolsAllowed": false
  },
  "candidate": {
    "maximumRuleChars": 1200,
    "maximumScopeChars": 800,
    "maximumRootCauseChars": 800,
    "maximumContraindications": 8,
    "maximumContraindicationChars": 500,
    "prohibitedPhrases": [
      "ignore previous",
      "system prompt",
      "expected answer",
      "checker.expected"
    ]
  },
  "pairedEvaluation": {
    "pairCount": 6,
    "minimumValidPairs": 6,
    "minimumCandidateAccuracy": 0.83,
    "minimumAbsoluteLift": 0.5,
    "maximumNoCandidateOnlyRegressions": 0,
    "maximumExactMcNemarP": 0.05
  },
  "liveActivationProfileByConcept": {
    "algebra-linear-equations": "linear_equation",
    "algebra-quadratics": "quadratic_roots",
    "functions-evaluation": "function_evaluation",
    "functions-inverse": "inverse_function",
    "series-geometric": "geometric_series",
    "algebra-absolute-value": "absolute_value_equation",
    "probability-binomial": "binomial_probability",
    "probability-complements": "complement_probability",
    "probability-combinatorics": "combinations_permutations"
  },
  "lessonExpiryDays": 90,
  "truthBoundary": "This policy records covered-once acquisition and genuine correction evidence only. It schedules and selects no reviews, proves no durable retention or general mastery, and does not modify model weights."
}
