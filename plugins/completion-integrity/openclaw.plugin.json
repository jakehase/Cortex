{
  "id": "completion-integrity",
  "name": "Completion Integrity",
  "version": "0.2.0",
  "entry": "./index.ts",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "stateDir": { "type": "string", "default": "/root/clawd/state/completion-integrity" },
      "workspaceRoot": { "type": "string", "default": "/root/clawd" },
      "validationMode": { "type": "string", "enum": ["light", "important_only", "strict"], "default": "important_only" },
      "autoDeliveryAfterMs": { "type": "number", "default": 15000 },
      "retryBackoffMs": { "type": "number", "default": 10000 },
      "pollIntervalMs": { "type": "number", "default": 10000 },
      "escalationAfterMs": { "type": "number", "default": 90000 }
    }
  }
}
