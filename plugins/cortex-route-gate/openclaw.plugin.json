{
  "id": "cortex-route-gate",
  "name": "Cortex Route Gate",
  "description": "Forces every agent run to consult Cortex routing first and injects the selected levels into the prompt.",
  "kind": "utility",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": { "type": "string" },
      "enabled": { "type": "boolean" },
      "requireRouting": { "type": "boolean" },
      "writeToken": { "type": "string", "minLength": 1 },
      "writeTokenHeader": { "type": "string", "minLength": 1 },
      "routeCacheHmacSecret": { "type": "string", "minLength": 1 },
      "sessionIdentityHmacSecret": { "type": "string", "minLength": 1 },
      "timeoutMs": { "type": "number", "minimum": 100, "maximum": 60000 },
      "maxCachedPlanAgeMs": { "type": "number", "minimum": 1000, "maximum": 86400000 },
      "maxResponseBytes": { "type": "number", "minimum": 1024, "maximum": 16777216 },
      "maxRoutingPromptBytes": { "type": "number", "minimum": 1024, "maximum": 1048576 },
      "maxLevels": { "type": "number", "minimum": 1, "maximum": 20 },
      "creativityGovernorEnabled": { "type": "boolean" },
      "creativityHistorySize": { "type": "number", "minimum": 4, "maximum": 100 },
      "creativityQuarantineTerms": { "type": "number", "minimum": 2, "maximum": 20 },
      "oracleSessionQuarantineEnabled": { "type": "boolean" },
      "oracleSessionResetBytes": { "type": "number", "minimum": 1024, "maximum": 1073741824 },
      "oracleSessionDir": { "type": "string", "minLength": 1 },
      "stateDir": { "type": "string" }
    }
  },
  "uiHints": {
    "baseUrl": { "label": "Cortex Base URL", "placeholder": "http://127.0.0.1:18888" },
    "enabled": { "label": "Enable route gate" },
    "requireRouting": { "label": "Require Cortex routing before answer generation" },
    "writeToken": { "label": "Cortex write token", "sensitive": true, "advanced": true },
    "writeTokenHeader": { "label": "Cortex write token header", "placeholder": "x-cortex-write-token", "advanced": true },
    "routeCacheHmacSecret": { "label": "Route cache HMAC secret", "sensitive": true, "advanced": true },
    "sessionIdentityHmacSecret": { "label": "Session identity HMAC secret", "sensitive": true, "advanced": true },
    "timeoutMs": { "label": "Routing timeout (ms)", "advanced": true },
    "maxCachedPlanAgeMs": { "label": "Maximum cached plan age (ms)", "advanced": true },
    "maxResponseBytes": { "label": "Maximum routing response size (bytes)", "advanced": true },
    "maxRoutingPromptBytes": { "label": "Maximum routing prompt size (bytes)", "advanced": true },
    "maxLevels": { "label": "Max routed levels", "advanced": true },
    "creativityGovernorEnabled": { "label": "Enable creativity governor", "advanced": true },
    "creativityHistorySize": { "label": "Creativity prompt history size", "advanced": true },
    "creativityQuarantineTerms": { "label": "Creativity quarantine term limit", "advanced": true },
    "oracleSessionQuarantineEnabled": { "label": "Archive oversized Oracle sessions", "advanced": true },
    "oracleSessionResetBytes": { "label": "Oracle session archive threshold (bytes)", "advanced": true },
    "oracleSessionDir": { "label": "Oracle session directory", "advanced": true },
    "creativityAuditEnabled": { "label": "Enable creativity output audit", "advanced": true },
    "creativityAuditOverlapThreshold": { "label": "Creativity audit overlap threshold", "advanced": true }
  }
}
