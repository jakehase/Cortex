{
  "id": "cortex-memory-bridge",
  "name": "Cortex Memory Bridge",
  "description": "Workspace-staged bridge plugin that proxies OpenClaw memory_search to a Cortex HTTP service.",
  "kind": "memory",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["sessionIdentityHmacSecret"],
    "properties": {
      "baseUrl": { "type": "string" },
      "writeToken": { "type": "string", "minLength": 1 },
      "writeTokenHeader": { "type": "string", "minLength": 1 },
      "searchPath": { "type": "string" },
      "storePath": { "type": "string" },
      "assurancePath": { "type": "string" },
      "timeoutMs": { "type": "number", "minimum": 100, "maximum": 60000 },
      "retryCount": { "type": "number", "minimum": 0, "maximum": 5 },
      "retryBackoffMs": { "type": "number", "minimum": 50, "maximum": 5000 },
      "enabledWriteThrough": { "type": "boolean" },
      "enabledCodecContinuity": { "type": "boolean" },
      "codecEventsPath": { "type": "string" },
      "maxResponseBytes": { "type": "number", "minimum": 1024, "maximum": 16777216 },
      "lifecycleMaxInFlight": { "type": "number", "minimum": 1, "maximum": 4096 },
      "lifecycleMaxPending": { "type": "number", "minimum": 1, "maximum": 16384 },
      "lifecycleSpoolMaxRecords": { "type": "number", "minimum": 1, "maximum": 65536 },
      "recentOutputMaxChars": { "type": "number", "minimum": 1, "maximum": 65536 },
      "stateDir": { "type": "string", "minLength": 1 },
      "tenantId": { "type": "string", "minLength": 1 },
      "workspaceId": { "type": "string", "minLength": 1 },
      "agentId": { "type": "string", "minLength": 1 },
      "userId": { "type": "string", "minLength": 1 },
      "channelId": { "type": "string", "minLength": 1 },
      "sessionId": { "type": "string", "minLength": 1 },
      "scopeCredentialId": { "type": "string", "minLength": 1 },
      "scopeHmacSecret": { "type": "string", "minLength": 1 },
      "sessionIdentityHmacSecret": { "type": "string", "minLength": 1, "pattern": "\\S" },
      "curatedBoost": { "type": "number", "minimum": 0, "maximum": 1 },
      "projectFactBoost": { "type": "number", "minimum": 0, "maximum": 1 },
      "durableCandidatePenalty": { "type": "number", "minimum": 0, "maximum": 1 },
      "noisyWhatsappPenalty": { "type": "number", "minimum": 0, "maximum": 1 },
      "noisyPatternPenalty": { "type": "number", "minimum": 0, "maximum": 1 },
      "minDurabilityScore": { "type": "number", "minimum": 0, "maximum": 1 },
      "writeTags": { "type": "array", "items": { "type": "string" } },
      "conflictPenalty": { "type": "number", "minimum": 0, "maximum": 1 },
      "recencyBoost": { "type": "number", "minimum": 0, "maximum": 1 },
      "explicitBoost": { "type": "number", "minimum": 0, "maximum": 1 },
      "corroborationBoost": { "type": "number", "minimum": 0, "maximum": 1 },
      "hardQueryCandidateCount": { "type": "number", "minimum": 1, "maximum": 50 },
      "debugShapes": { "type": "boolean" }
    }
  },
  "uiHints": {
    "baseUrl": {
      "label": "Cortex Base URL",
      "placeholder": "http://127.0.0.1:18888"
    },
    "writeToken": {
      "label": "Cortex write token",
      "sensitive": true,
      "advanced": true
    },
    "writeTokenHeader": {
      "label": "Cortex write token header",
      "placeholder": "x-cortex-write-token",
      "advanced": true
    },
    "searchPath": {
      "label": "Search Path",
      "placeholder": "/knowledge/search"
    },
    "storePath": {
      "label": "Assurance Commit Path",
      "placeholder": "/nexus/commit"
    },
    "assurancePath": {
      "label": "Assurance Receipt Path",
      "placeholder": "/nexus/assurance/receipt",
      "advanced": true
    },
    "timeoutMs": {
      "label": "HTTP Timeout (ms)",
      "placeholder": "12000",
      "advanced": true
    },
    "retryCount": {
      "label": "Retry Count",
      "placeholder": "2",
      "advanced": true
    },
    "retryBackoffMs": {
      "label": "Retry Backoff (ms)",
      "placeholder": "350",
      "advanced": true
    },
    "enabledWriteThrough": {
      "label": "Enable assurance-gated write-through",
      "advanced": true,
      "help": "Opt in after configuring tenant/workspace scope and Nexus assurance. Candidates are committed only when the assurance gate confirms durable storage."
    },
    "enabledCodecContinuity": {
      "label": "Enable Codec continuity persistence",
      "advanced": true,
      "help": "Enabled by default. Configure principal-scoped credentials and the shared session identity secret before production use."
    },
    "scopeCredentialId": {
      "label": "Memory scope credential ID",
      "advanced": true
    },
    "scopeHmacSecret": {
      "label": "Credential-specific scope HMAC secret",
      "sensitive": true,
      "advanced": true
    },
    "sessionIdentityHmacSecret": {
      "label": "Shared session identity HMAC secret",
      "sensitive": true,
      "advanced": true,
      "help": "Explicitly provision the exact same secret in cortex-memory-bridge and cortex-route-gate. It has no built-in default."
    },
    "curatedBoost": {
      "label": "Curated Result Boost",
      "advanced": true,
      "placeholder": "0.24"
    },
    "projectFactBoost": {
      "label": "Project-State Boost",
      "advanced": true,
      "placeholder": "0.12"
    },
    "durableCandidatePenalty": {
      "label": "Vague Candidate Penalty",
      "advanced": true,
      "placeholder": "0.14"
    },
    "noisyWhatsappPenalty": {
      "label": "Vague WhatsApp Penalty",
      "advanced": true,
      "placeholder": "0.26"
    },
    "noisyPatternPenalty": {
      "label": "Noise Pattern Penalty",
      "advanced": true,
      "placeholder": "0.2"
    }
  }
}
