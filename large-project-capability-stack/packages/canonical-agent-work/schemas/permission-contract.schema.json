{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clawd.agent_work.permission_contract.v1",
  "title": "Agent Work v1 permission contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "allow", "forbid", "externalWritesAllowed", "defaultDenyExternalWrites", "generatedAt", "source"],
  "properties": {
    "schemaVersion": { "const": "clawd.agent_work.permission_contract.v1" },
    "runId": { "type": "string", "minLength": 1 },
    "allow": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "forbid": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "externalWritesAllowed": { "type": "boolean" },
    "defaultDenyExternalWrites": { "const": true },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": { "type": "object", "additionalProperties": true }
  }
}
