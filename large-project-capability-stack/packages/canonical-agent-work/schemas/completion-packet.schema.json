{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clawd.agent_work.completion_packet.v1",
  "title": "Agent Work v1 terminal completion packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "status", "sourceDigest", "objectiveTruth", "requiredArtifacts", "allowedClaims", "rejectedClaims", "reviewerStatus", "generatedAt"],
  "properties": {
    "schemaVersion": { "const": "clawd.agent_work.completion_packet.v1" },
    "runId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["green", "blocked", "cancelled", "failed"] },
    "sourceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "objectiveTruth": { "enum": ["green", "red", "unknown", "not_applicable"] },
    "requiredArtifacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "allowedClaims": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "rejectedClaims": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "reviewerStatus": { "enum": ["pending", "passed", "failed", "not_required"] },
    "generatedAt": { "type": "string", "format": "date-time" }
  }
}
