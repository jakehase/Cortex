{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clawd.agent_work.lease.v1",
  "title": "Agent Work v1 fenced lease",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "leaseId", "runId", "taskId", "workerId", "fencingToken", "state", "acquiredAt", "expiresAt", "idempotencyKey"],
  "properties": {
    "schemaVersion": { "const": "clawd.agent_work.lease.v1" },
    "leaseId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "workerId": { "type": "string", "minLength": 1 },
    "fencingToken": { "type": "integer", "minimum": 1 },
    "state": { "enum": ["active", "expired", "released", "revoked"] },
    "acquiredAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "idempotencyKey": { "type": "string", "minLength": 1 }
  }
}
