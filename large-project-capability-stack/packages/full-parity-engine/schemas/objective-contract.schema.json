  "properties": {
    "schemaVersion": {"const": "clawd.full_parity.objective_contract.v0"},
    "anchor": {"type": "string", "minLength": 1},
    "targetPath": {"type": "string", "minLength": 1},
    "fidelity": {"enum": ["prototype", "production_slice", "parity_for_scope", "full_clone"]},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "implementationSurface": {"type": "string", "minLength": 1},
    "stopCondition": {"type": "string", "minLength": 1},
    "doneWhen": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
