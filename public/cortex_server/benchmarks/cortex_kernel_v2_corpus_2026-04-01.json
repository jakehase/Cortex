  "cases": [
    {
      "id": "oracle_micro_fact_fast",
      "class": "micro_utility",
      "runtime": "oracle",
      "surface": "chat",
      "title": "Oracle factual fast-path",
      "lane_tendency": "fast",
      "latency_slo_ms": 520,
      "quality_expectation": "Deterministic factual answer with fast lane trace.",
      "failure_heuristics": [
        "non-200 response",
        "missing kernel trace",
        "lane not fast",
        "response missing Austin"
      ],
      "request": {
        "method": "POST",
        "path": "/oracle/chat",
        "json": {
          "prompt": "What is the capital of Texas?",
          "priority": "normal"
        }
      },
      "measure_event": true,
      "checks": [
        {
          "path": "status_code",
          "op": "eq",
          "value": 200
        },
        {
          "path": "response.lane",
          "op": "eq",
          "value": "semantic_guardrail_factual"
        },
        {
          "path": "response.response",
          "op": "contains",
          "value": "Austin"
        },
        {
          "path": "response.routing_trace.kernel_v2.plan.lane",
          "op": "eq",
          "value": "fast"
        },
        {
          "path": "kernel_event.actual_lane_family",
          "op": "eq",
          "value": "fast"
        }
      ]
    },
    {
