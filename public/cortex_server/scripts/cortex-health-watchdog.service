[Unit]
Description=Cortex availability and memory-pressure watchdog
After=cortex.service

[Service]
Type=oneshot
ExecStart=/root/clawd/public/cortex_server/scripts/cortex_health_watchdog.sh
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RuntimeDirectory=cortex-health-watchdog
RuntimeDirectoryMode=0700
StateDirectory=cortex-health-watchdog
StateDirectoryMode=0700
ReadWritePaths=/run/cortex-health-watchdog /var/lib/cortex-health-watchdog
TimeoutStartSec=45s
