[Unit]
Description=WhatsApp terminal-state notifier for Cortex hardening continuation v18
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/clawd
ExecStart=/usr/bin/python3 /root/clawd/scripts/detached_job_notifier.py --ssh-host jake@37.27.129.239 --state-file /home/jake/cortex-hardening/cortex-hardening-20260711T2330Z/continuation-v18-state.json --job-label "Cortex hardening continuation v18" --sender /usr/bin/openclaw --poll-seconds 30
