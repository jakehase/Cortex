[Unit]
Description=Cortex q9 availability, capacity, and recovery watchdog
After=cortex.service

[Service]
Type=oneshot
ExecStart=/opt/cortex/current/public/cortex_server/scripts/cortex_health_watchdog.sh
User=root
Group=root
EnvironmentFile=/etc/cortex/cortex.env
Environment="CORTEX_WATCHDOG_SERVER_ROOT=/opt/cortex/current/public/cortex_server"
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RuntimeDirectory=cortex-health-watchdog
RuntimeDirectoryMode=0700
StateDirectory=cortex-health-watchdog
StateDirectoryMode=0700
ReadOnlyPaths=/opt/cortex/releases /etc/cortex
ReadWritePaths=/run/cortex-health-watchdog /var/lib/cortex-health-watchdog /var/lib/cortex/attestations
TimeoutStartSec=60s
