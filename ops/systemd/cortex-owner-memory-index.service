[Unit]
Description=Cortex owner-memory source index refresh
After=cortex.service
Wants=cortex.service
ConditionPathExists=/var/lib/cortex/owner-file-sources.json

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/cortex/current
ExecStart=/usr/bin/python3 /opt/cortex/current/scripts/index-owner-memory.py apply --verification-max-age-seconds 3600
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/opt/cortex/current /root/clawd /root/.openclaw/openclaw.json
ReadWritePaths=/var/lib/cortex
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
