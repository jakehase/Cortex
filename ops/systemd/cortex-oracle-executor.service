[Unit]
Description=Cortex narrowly privileged Oracle executor
Documentation=file:/opt/cortex/current/cortex-repair-20261011/SECURITY_POLICY_MIGRATION.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Root is retained only for the existing root-owned OpenClaw OAuth/profile
# state. The capability set is empty and the home mount namespace exposes only
# the Oracle workspace/config while helper lifecycle state is service-owned.
User=root
Group=root
WorkingDirectory=/opt/cortex/current
EnvironmentFile=/etc/cortex/oracle-helper.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# /usr/bin/openclaw otherwise selects the shared restored state tree. Keep
# helper lifecycle/plugin/session state private while mounting only the
# approved provider profile OpenClaw resolves through the main-agent fallback.
Environment=OPENCLAW_STATE_DIR=/var/lib/cortex-oracle/openclaw-state
# The helper consumes an immutable Oracle-only config from the exact release.
# Never bind the gateway config here: it owns channel plugins and secrets whose
# paths intentionally remain outside this service's mount namespace.
Environment=OPENCLAW_CONFIG_PATH=/opt/cortex/current/ops/config/oracle-openclaw.json
Environment=ORACLE_EXECUTOR_AGENT=oracle
Environment=ORACLE_EXECUTOR_MODEL=gpt-5.6-sol
Environment=ORACLE_EXECUTOR_THINKING=xhigh
Environment=ORACLE_EXECUTOR_AUTH_POLICY=pmhnp_oauth_approved_2026-09-25
Environment=ORACLE_EXECUTOR_SERVICE_TIER_POLICY=provider_default_no_override
Environment=ORACLE_EXECUTOR_LOCAL=true
Environment=ORACLE_EXECUTOR_RESET_AGENT_SESSION=false
Environment=ORACLE_EXECUTOR_SESSION_MODE=ephemeral
Environment=ORACLE_EXECUTOR_SESSION_DIR=/var/lib/cortex-oracle/openclaw-state/agents/oracle/sessions
Environment=ORACLE_EXECUTOR_WORKDIR=/root/clawd/deploy/oracle-workspace-lite
ExecStart=/usr/bin/python3 -m uvicorn deploy.oracle_executor:app --host 127.0.0.1 --port 18999
Restart=always
RestartSec=3s
TimeoutStartSec=90s
TimeoutStopSec=20s
KillSignal=SIGINT
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=tmpfs
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/cortex/releases /etc/cortex
ReadWritePaths=/var/lib/cortex-oracle /var/log/cortex-oracle /run/cortex-oracle
BindReadOnlyPaths=/root/clawd/deploy/oracle-workspace-lite
# Keep OAuth refreshes coherent with the gateway without exposing main-agent
# sessions or the rest of the shared OpenClaw state tree.
BindPaths=/opt/openclaw-preastra-restore/2026.7.1-2/state/agents/main/agent:/var/lib/cortex-oracle/openclaw-state/agents/main/agent
InaccessiblePaths=-/root/.ssh -/root/.aws -/root/.config/gh -/root/.kube -/opt/clawdbot /opt/openclaw-preastra-restore/2026.7.1-2/state
RuntimeDirectory=cortex-oracle
RuntimeDirectoryMode=0700
StateDirectory=cortex-oracle
StateDirectoryMode=0700
LogsDirectory=cortex-oracle
LogsDirectoryMode=0700
UMask=0077
CPUAccounting=yes
TasksAccounting=yes
CPUQuota=150%
TasksMax=128
MemoryHigh=1G
MemoryMax=2G
MemorySwapMax=256M
OOMPolicy=stop

[Install]
WantedBy=multi-user.target
