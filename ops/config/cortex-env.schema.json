{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortex.local/schemas/cortex-q9-environment.json",
  "title": "Cortex q9 production environment contract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "CORTEX_ENV",
    "CORTEX_SAFE_MODE",
    "CORTEX_WRITE_AUTH_MODE",
    "CORTEX_WRITE_TOKEN",
    "CORTEX_ADMIN_TOKEN",
    "CORTEX_MEMORY_SCOPE_STRICT",
    "CORTEX_MEMORY_SCOPE_CREDENTIALS",
    "CORTEX_DB_PATH",
    "CORTEX_CHROMA_DIR",
    "CORTEX_L22_STRUCTURED_DB",
    "CORTEX_RELEASE_ROOT",
    "CORTEX_RELEASE_ENVELOPE_PATH",
    "CORTEX_AIOS_ATTESTATION_PATH",
    "CORTEX_CANARY_RECEIPT_PATH",
    "CORTEX_ROLLBACK_RECEIPT_PATH",
    "CORTEX_REMOTE_PERSISTENCE_RECEIPT_PATH",
    "ORACLE_OLLAMA_ENABLED",
    "ORACLE_OLLAMA_URL"
  ],
  "properties": {
    "CORTEX_ENV": {"const": "production"},
    "CORTEX_SAFE_MODE": {"enum": ["true", "1"]},
    "CORTEX_WRITE_AUTH_MODE": {"const": "token_required"},
    "CORTEX_WRITE_TOKEN": {"type": "string", "minLength": 32},
    "CORTEX_ADMIN_TOKEN": {"type": "string", "minLength": 32},
    "CORTEX_MEMORY_SCOPE_STRICT": {"enum": ["true", "1"]},
    "CORTEX_MEMORY_SCOPE_CREDENTIALS": {"type": "string", "minLength": 2},
    "CORTEX_DB_PATH": {"const": "/opt/clawdbot/knowledge/cortex_graph.db"},
    "CORTEX_CHROMA_DIR": {"const": "/var/lib/cortex/chroma"},
    "CORTEX_L22_STRUCTURED_DB": {"const": "/opt/clawdbot/state/l22-structured.db"},
    "CORTEX_RELEASE_ROOT": {"pattern": "^/opt/cortex/releases/[A-Za-z0-9._-]+$"},
    "CORTEX_RELEASE_ENVELOPE_PATH": {"pattern": "^/var/lib/cortex/attestations/[A-Za-z0-9._-]+\\.json$"},
    "CORTEX_AIOS_ATTESTATION_PATH": {"const": "/var/lib/cortex/attestations/aios-latest.json"},
    "CORTEX_CANARY_RECEIPT_PATH": {"const": "/var/lib/cortex/attestations/canary-latest.json"},
    "CORTEX_ROLLBACK_RECEIPT_PATH": {"const": "/var/lib/cortex/attestations/rollback-latest.json"},
    "CORTEX_REMOTE_PERSISTENCE_RECEIPT_PATH": {"const": "/var/lib/cortex/attestations/remote-persistence-latest.json"},
    "ORACLE_OLLAMA_ENABLED": {"enum": ["true", "1"]},
    "ORACLE_OLLAMA_URL": {"const": "http://127.0.0.1:11434"}
  },
  "x-secretKeys": [
    "CORTEX_WRITE_TOKEN",
    "CORTEX_ADMIN_TOKEN",
    "CORTEX_CODEC_ADMIN_TOKEN",
    "CORTEX_MEMORY_SCOPE_CREDENTIALS",
    "NEXUS_OUTCOME_FEEDBACK_SIGNING_KEY"
  ],
  "x-truthBoundary": "Schema validation proves configuration shape and mandatory boundaries, never credential correctness or runtime health."
}
