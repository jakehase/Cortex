{
  "schemaVersion": "cortex.runtime-surface-contract.v2",
  "release": {
    "rootPattern": "/opt/cortex/releases/<release-id>",
    "currentPointer": "/opt/cortex/current",
    "readOnly": true,
    "sourceTreeWritesAllowed": false
  },
  "units": [
    {"name": "cortex.service", "template": "ops/systemd/cortex.service", "required": true},
    {"name": "cortex-oracle-executor.service", "template": "ops/systemd/cortex-oracle-executor.service", "required": true},
    {"name": "cortex-health-watchdog.service", "template": "ops/systemd/cortex-health-watchdog.service", "required": true},
    {"name": "cortex-health-watchdog.timer", "template": "ops/systemd/cortex-health-watchdog.timer", "required": true},
    {"name": "cortex-owner-memory-index.service", "template": "ops/systemd/cortex-owner-memory-index.service", "required": true},
    {"name": "cortex-owner-memory-index.timer", "template": "ops/systemd/cortex-owner-memory-index.timer", "required": true},
    {"name": "cortex-ollama-tunnel.service", "template": "ops/systemd/cortex-ollama-tunnel.service.template", "required": true, "containsDeploymentPlaceholder": true},
    {"name": "openclaw-gateway.service", "ownership": "OpenClaw", "required": true, "managedByQ9": false}
  ],
  "configuration": [
    {"path": "/etc/cortex/cortex.env", "schema": "ops/config/cortex-env.schema.json", "secretBearing": true, "mode": "0600"},
    {"path": "/etc/cortex/oracle-helper.env", "secretBearing": true, "mode": "0600"},
    {"path": "/opt/cortex/current/ops/config/oracle-openclaw.json", "source": "ops/config/oracle-openclaw.json", "secretBearing": false, "immutable": true, "ownerUnit": "cortex-oracle-executor.service"},
    {"path": "/root/.openclaw/openclaw.json", "secretBearing": true, "mode": "0600", "managedByQ9": false},
    {"path": "/root/clawd/config/ai-os-adapter/default.json", "secretBearing": false, "managedByQ9": false}
  ],
  "sourceClassification": {
    "matchPolicy": "first_match",
    "trackedCategories": [
      {
        "name": "quarantined",
        "pathComponents": ["_quarantine"],
        "releaseDisposition": "immutable_inert"
      },
      {
        "name": "generated",
        "pathComponents": ["artifacts"],
        "exactPaths": ["public/.export-manifest.json"],
        "releaseDisposition": "immutable_snapshot"
      },
      {
        "name": "product",
        "default": true,
        "releaseDisposition": "immutable_runtime"
      }
    ],
    "privateRuntime": {
      "trackedFilesAllowed": false,
      "releaseDisposition": "external_mutable_never_packaged",
      "absoluteRoots": [
        "/opt/clawdbot",
        "/var/lib/cortex",
        "/var/log/cortex",
        "/run/cortex",
        "/var/lib/cortex-health-watchdog",
        "/var/lib/cortex-oracle",
        "/var/log/cortex-oracle",
        "/run/cortex-oracle",
        "/opt/openclaw-preastra-restore/2026.7.1-2/state/agents/main/agent",
        "/root/.openclaw"
      ]
    }
  },
  "qualification": {
    "receiptSchemaVersion": "cortex.qualification-receipt.v1",
    "requiredReceiptKinds": ["full-suite", "focused-gates"],
    "focusedSurfaceIds": [
      "ROUTE-1",
      "ROUTE-2",
      "MEM-1",
      "SEC-1",
      "POLICY-1",
      "POLICY-2",
      "HEALTH-1",
      "HEALTH-2",
      "PARSER-1",
      "MEM-2",
      "MEM-3",
      "BROWSER-1",
      "OPS-1",
      "OPS-2",
      "AIOS-1",
      "SEC-2"
    ],
    "receiptsMustMatchSourceCommitAndTree": true,
    "replayCommandRequired": true,
    "hashedArtifactRequired": true
  },
  "promotion": {
    "surfaceMatrix": "cortex-repair-20261011/surface-matrix.json",
    "gatewayCodeManifestReceiptSchemaVersion": "cortex.gateway-code-manifest-preflight.v1",
    "requiredReceipts": ["deployment", "rollback", "redeploy"],
    "authoritativeAcceptedRefNamespace": "refs/heads/accepted/",
    "remoteResolutionRequired": true,
    "localTrackingRefIsNotAuthoritative": true,
    "terminalStateProducer": "cortex.release-supervisor.v1"
  },
  "mutableRoots": [
    {"path": "/var/lib/cortex", "purpose": "Cortex databases, structured state, attestations, release-controller state and Chroma"},
    {"path": "/var/log/cortex", "purpose": "runtime logs"},
    {"path": "/run/cortex", "purpose": "ephemeral runtime coordination"},
    {"path": "/var/lib/cortex-oracle", "purpose": "Oracle helper-owned OpenClaw lifecycle, plugin and ephemeral session state", "ownerUnit": "cortex-oracle-executor.service"},
    {"path": "/opt/openclaw-preastra-restore/2026.7.1-2/state/agents/main/agent", "purpose": "Approved OpenAI OAuth profile store mounted into the helper without main-agent sessions", "ownerUnit": "openclaw-gateway.service", "sharedWith": "cortex-oracle-executor.service"},
    {"path": "/var/log/cortex-oracle", "purpose": "Oracle helper logs"},
    {"path": "/run/cortex-oracle", "purpose": "Oracle helper runtime coordination"},
    {"path": "/var/lib/cortex-health-watchdog", "purpose": "watchdog state"}
  ],
  "externalDependencies": [
    {"name": "OpenClaw gateway", "endpoint": "ws://127.0.0.1:18789", "writeBoundary": "separately approved"},
    {"name": "TinyLlama Ollama lane", "endpoint": "http://127.0.0.1:11434", "transport": "root-owned loopback SSH tunnel"},
    {"name": "Redis", "endpoint": "redis://127.0.0.1:6379"},
    {"name": "authoritative Git remote", "endpoint": "https://github.com/jakehase/Cortex.git", "writeBoundary": "release-only"}
  ],
  "operationalScripts": [
    "scripts/codex-worker-launcher.mjs",
    "scripts/remote-completion-handoff.mjs",
    "scripts/artifact-retention.mjs",
    "scripts/index-owner-memory.py",
    "public/cortex_server/scripts/cortex_health_watchdog.sh",
    "scripts/build-release-envelope.py",
    "scripts/verify-release-envelope.py",
    "scripts/deploy-q9-release.py",
    "scripts/detached_job_notifier.py"
  ],
  "requiredAttestations": [
    "/var/lib/cortex/attestations/aios-latest.json",
    "/var/lib/cortex/attestations/canary-latest.json",
    "/var/lib/cortex/attestations/rollback-latest.json",
    "/var/lib/cortex/attestations/remote-persistence-latest.json"
  ],
  "truthBoundary": "Every deployed executable/config/unit/state root must appear here or the q9 release gate fails. Secret values are never embedded in this contract."
}
